{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true
  },
  "include": [
    "src/components/community/**/*",
    "src/lib/community/**/*",
    "functions/api/board.ts",
    "functions/_lib/community-auth.ts",
    "functions/api/community-auth/**/*",
    "functions/_lib/community-seo.ts",
    "functions/boards/[slug].ts",
    "functions/posts/[id].ts",
    "functions/sitemap.xml.ts",
    "functions/sitemap-posts.xml.ts"
  ]
}
