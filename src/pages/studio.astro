<Layout title="Workfolio Studio | 웹사이트 제작 · 앱 개발 · 유지보수" description="웹사이트와 앱 제작, 바이브코딩 유지보수와 구독형 관리 서비스를 제공하는 Workfolio Studio입니다.">
  <Header />
  <main>
    <Hero />
    <Services />
    <Process />
    <Pricing />
    <Portfolio />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
