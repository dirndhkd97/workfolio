---
import '../styles/global.css';
import { HOME_DESCRIPTION, SITE_ORIGIN, SOCIAL_IMAGE } from '../lib/community/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = '워크폴리오 | 직장인 익명 커뮤니티',
  description = HOME_DESCRIPTION,
  canonical,
  noindex = /^\/(auth|my|admin|checkout|demo)(\/|$)/.test(Astro.url.pathname),
} = Astro.props;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_ORIGIN).href;
const isStudio = /^\/studio\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${SITE_ORIGIN}/community-favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={isStudio ? `${SITE_ORIGIN}/og-image.svg` : SOCIAL_IMAGE} />
    <meta property="og:site_name" content="Workfolio" />
    <meta property="og:locale" content="ko_KR" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={isStudio ? `${SITE_ORIGIN}/og-image.svg` : SOCIAL_IMAGE} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      rel="stylesheet"
    />
    <title>{title}</title>
    {isStudio && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Workfolio",
      "alternateName": "buildWon",
      "url": `${SITE_ORIGIN}/studio/`,
      "description": "웹사이트, 앱 제작부터 바이브코딩 유지보수, 구독형 관리 서비스까지. 합리적인 외주 개발 파트너.",
      "priceRange": "₩500,000~",
      "email": "contact@workfolio.life",
      "areaServed": "KR",
      "serviceType": ["웹사이트 제작", "앱 개발", "바이브코딩 유지보수", "웹사이트 유지보수"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "서비스",
        "itemListElement": [
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "웹사이트 제작", "description": "랜딩페이지, 기업 홈페이지, 쇼핑몰 제작"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "앱 개발", "description": "iOS/Android 크로스 플랫폼 앱 개발"}},
          {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "구독형 관리", "description": "월 3만원부터 호스팅, 도메인, 콘텐츠 관리"}}
        ]
      }
    })} />}
  </head>
  <body>
    <slot />
  </body>
</html>
